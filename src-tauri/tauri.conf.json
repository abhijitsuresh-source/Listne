{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Listne",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "sidecar": true,
        "scope": [
          { "name": "whisper-cli", "sidecar": true },
          { "name": "ollama", "cmd": "ollama" }
        ]
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/*", "$DOCUMENT/*", "$DOWNLOAD/*", "$HOME/*"]
      },
      "dialog": { "all": true },
      "notification": { "all": true },
      "http": {
        "all": true,
        "scope": ["https://api.gumroad.com/**", "http://localhost:11434/**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.gugubi.listne",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png"
      ],
      "resources": [
        "binaries/ggml-base.en.bin",
        "binaries/ggml-small.en.bin",
        "binaries/ggml-medium.en.bin",
        "binaries/ffmpeg-aarch64-apple-darwin"
      ],
      "externalBin": [
        "binaries/whisper-cli"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/your-username/listne/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "YOUR_UPDATER_PUBLIC_KEY"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Listne",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
